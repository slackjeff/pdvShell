function populate_database_vendas() {
	local i
	local dia mes ano
	local data quantidade preco_cents preco total_cents total docnr id
	local docnr_atual
	local values

	msgok "$(gettext "Populando tabela vendas")"
	# Inicialize o dia, mês e ano
	dia=1
	mes=1
	ano="$(date +"%Y")"

	# Número de documento inicial (uma única consulta, depois só incrementa em bash)
	docnr_atual=$(sqlite3 "$database" "SELECT COALESCE(MAX(docnr), 0) FROM vendas;")
	docnr_atual=$((10#$docnr_atual))

	values=""
	# Loop para inserir 365 registros
	for ((i = 1; i <= 365; i++)); do
		printf -v data '%04d-%02d-%02d' "$ano" "$mes" "$dia" # Construir a data no formato 'AAAA-MM-DD'
		quantidade=$((RANDOM % 10 + 1))                      # Gere uma quantidade aleatória entre 1 e 10
		preco_cents=$RANDOM                                  # Gere um preço aleatório com duas casas decimais
		printf -v preco '%d.%02d' $((preco_cents / 100)) $((preco_cents % 100))
		total_cents=$((quantidade * preco_cents)) # Calcule o total
		printf -v total '%d.%02d' $((total_cents / 100)) $((total_cents % 100))
		((++docnr_atual))
		printf -v docnr '%07d' "$docnr_atual"
		id=$i

		[[ -n "$values" ]] && values+=","
		values+="('$id', '$data', $quantidade, $preco, $total, '$docnr')"

		dia=$((dia + 1))

		# Verificar mês fevereiro
		if [[ $mes -eq 2 && $dia -gt 28 ]]; then
			dia=1
			mes=$((mes + 1))
		fi

		# Verificar se o mês mudou
		if [ $dia -gt 30 ]; then
			dia=1
			mes=$((mes + 1))
			if [[ $mes -gt 12 ]]; then
				mes=1
				ano=$((ano + 1))
			fi
		fi
	done

	# Inserir todos os registros de uma vez na tabela 'vendas' no banco de dados
	sqlite3 "$database" "INSERT INTO vendas (id, data, quantidade, preco, total, docnr) VALUES $values;"
}

function populate_database_compras() {
