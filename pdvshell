function read_key() {
	local k seq

	IFS= read -rsn1 k || {
		LAST_KEY=""
		return 1
	}

	case "$k" in
	$'\e')
		if IFS= read -rsn1 -t 0.05 seq && [[ $seq == "[" ]]; then
			IFS= read -rsn1 seq
			case "$seq" in
			A) LAST_KEY="$K_UP" ;;
			B) LAST_KEY="$K_DOWN" ;;
			C) LAST_KEY="$K_RIGHT" ;;
			D) LAST_KEY="$K_LEFT" ;;
			H) LAST_KEY="$K_HOME" ;;
			F) LAST_KEY="$K_END" ;;
			5)
				read -rsn1
				LAST_KEY="$K_PGUP"
				;;
			6)
				read -rsn1
				LAST_KEY="$K_PGDN"
				;;
			*) LAST_KEY="$K_ESC" ;;
			esac
		else
			LAST_KEY="$K_ESC"
		fi
		;;
	"")
		LAST_KEY="$K_ENTER"
		;;
	*)
		printf -v LAST_KEY '%d' "'$k"
		;;
	esac
}

