function relatorio_vendas_diarias() {
	local xtitle="${Relatorio_de^^} ${Vendas_Diarias^^}"
	local query_result
	local dini dfim
	local data_inicio="01-$(date +"%m-%Y")"
	local data_fim=$(date +"%d-%m-%Y")
	local total_mes current_mes
	local new_mes total data
	local Max_field_width
	local qtd_itens num_vendas qtd_mes vendas_mes
	local ticket_medio ticket_medio_mes total_mes_fmt total_fmt
	local dini_ptbr dfim_ptbr xtitle_periodo
	local total_geral qtd_geral vendas_geral ticket_medio_geral total_geral_fmt
	local -a linhas_vendas

	tela
	titulo 1 "$xtitle" "${Acores[statussup]}"
	box "$nTop" 0 4 $(($(lastcol) - 1)) "$xtitle" "${Acores[box]}"
	print $((nTop + 1)) 1 "$(gettext "Data Inicial")    : "
	print $((nTop + 2)) 1 "$(gettext "Data Final")      : "

	while true; do
		get $((nTop + 1)) 1 "$(gettext "Data Inicial")    : " dini "$data_inicio" || return
		if [[ -n "$dini" ]]; then
			if validar_data "$dini"; then
				break
			else
				msgerror "$(gettext "Data inválida")"
				continue
			fi
		else
			setpos 12 01
			if readconf "$(gettext "A data não pode ser em branco. Cancelar?")"; then
				return
			fi
		fi
	done

	while true; do
		get $((nTop + 2)) 1 "$(gettext "Data Final")      : " dfim "$data_fim" || return
		if [[ -n "$dfim" ]]; then
			if validar_data "$dfim"; then
				break
			else
				msgerror "$(gettext "Data inválida")"
				continue
			fi
		else
			setpos 12 01
			if readconf "$(gettext "A data não pode ser em branco. Cancelar?")"; then
				return
			fi
		fi
	done

	dini_ptbr="$dini"
	dfim_ptbr="$dfim"
	dini=$(convert_date_to_US "$dini")
	dfim=$(convert_date_to_US "$dfim")

	# Consulta para obter resultados diários agrupados por ano e mês
	mensagem "$xtitle" "$(gettext "Processando...")" 0 "$yellow"
	query_result=$(sqlite3 "$database" "SELECT date(data), SUM(total), SUM(quantidade), COUNT(DISTINCT docnr) FROM vendas WHERE date(data) BETWEEN '$dini' AND '$dfim' GROUP BY date(data) ORDER BY date(data) ASC")

	if [[ -z "${query_result}" ]]; then
		msgok "" "" -1
		return
	fi

	total_mes=0
	qtd_mes=0
	vendas_mes=0
	total_geral=0
	qtd_geral=0
	vendas_geral=0
	current_mes=
	linhas_vendas=()
	while IFS='|' read -r data total qtd_itens num_vendas; do
		new_mes="${data:5:2}" # SQLite date() sempre devolve AAAA-MM-DD
		if [[ -n "$current_mes" && "$current_mes" != "$new_mes" ]]; then
			arredondar_moeda "$total_mes"
			total_mes_fmt="${ARREDONDAR_MOEDA_RESULT/./,}"
			ticket_medio_mes=0
			((vendas_mes > 0)) && ticket_medio_mes=$(echo "$total_mes / $vendas_mes" | bc -l)
			arredondar_moeda "$ticket_medio_mes"
			linhas_vendas+=("SOMA MENSAL|$total_mes_fmt|$qtd_mes|$vendas_mes|${ARREDONDAR_MOEDA_RESULT/./,}|$red")
			linhas_vendas+=("")
			total_mes=0
			qtd_mes=0
			vendas_mes=0
		fi

		total_mes=$(echo "$total_mes + $total" | bc -l)
		qtd_mes=$((qtd_mes + qtd_itens))
		vendas_mes=$((vendas_mes + num_vendas))

		total_geral=$(echo "$total_geral + $total" | bc -l)
		qtd_geral=$((qtd_geral + qtd_itens))
		vendas_geral=$((vendas_geral + num_vendas))

		arredondar_moeda "$total"
		total_fmt="${ARREDONDAR_MOEDA_RESULT/./,}"
		ticket_medio=0
		((num_vendas > 0)) && ticket_medio=$(echo "$total / $num_vendas" | bc -l)
		arredondar_moeda "$ticket_medio"
		linhas_vendas+=("$(convert_date_to_ptBR "$data")|$total_fmt|$qtd_itens|$num_vendas|${ARREDONDAR_MOEDA_RESULT/./,}")
		current_mes="$new_mes"
	done <<<"${query_result}"
	arredondar_moeda "$total_mes"
	total_mes_fmt="${ARREDONDAR_MOEDA_RESULT/./,}"
	ticket_medio_mes=0
	((vendas_mes > 0)) && ticket_medio_mes=$(echo "$total_mes / $vendas_mes" | bc -l)
	arredondar_moeda "$ticket_medio_mes"
	linhas_vendas+=("SOMA MENSAL|$total_mes_fmt|$qtd_mes|$vendas_mes|${ARREDONDAR_MOEDA_RESULT/./,}|$red")

	# SOMA GERAL: soma de todo o período consultado (todos os meses),
	# não só do último mês - sempre a última linha do relatório.
	linhas_vendas+=("")
	ticket_medio_geral=0
	((vendas_geral > 0)) && ticket_medio_geral=$(echo "$total_geral / $vendas_geral" | bc -l)
	arredondar_moeda "$total_geral"
	total_geral_fmt="${ARREDONDAR_MOEDA_RESULT/./,}"
	arredondar_moeda "$ticket_medio_geral"
	linhas_vendas+=("SOMA GERAL|$total_geral_fmt|$qtd_geral|$vendas_geral|${ARREDONDAR_MOEDA_RESULT/./,}|$red")

	xtitle_periodo="$xtitle - $(gettext "PERÍODO") $dini_ptbr/$dfim_ptbr"

	calcular_larguras "10|10|9|9|12" "1|1|1|1|1" "$(($(lastcol) - 2))"
	Max_field_width="$CALC_LARGURAS_RESULT"

	browse_tabela "$((nTop + 4))" 0 "$(($(lastrow) - $((nTop + 4))))" "$(($(lastcol) - 1))" "$xtitle_periodo" \
		"DATA|TOTAL DIA|QTD ITENS|Nº VENDAS|TICKET MÉDIO" "$Max_field_width" linhas_vendas "${Acores[box]}"
}

