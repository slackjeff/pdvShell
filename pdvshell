}

# Multiplica dois valores decimais (ex: quantidade x preço) sem usar bc.
# Assume até 2 casas decimais (padrão de preço do sistema). Resultado em
# DEC_RESULT, formatado com 2 casas decimais.
# Uso: dec_mult "$quantidade" "$valor"; echo "$DEC_RESULT"
function dec_mult() {
	local a="$1" b="$2"
	local a_int a_dec b_int b_dec
	a_int="${a%%.*}"
	if [[ "$a" == *.* ]]; then a_dec="${a#*.}"; else a_dec=0; fi
	b_int="${b%%.*}"
	if [[ "$b" == *.* ]]; then b_dec="${b#*.}"; else b_dec=0; fi
	a_dec="${a_dec}00"
	a_dec="${a_dec:0:2}"
	b_dec="${b_dec}00"
	b_dec="${b_dec:0:2}"
	local a_cents=$((10#$a_int * 100 + 10#$a_dec))
	local b_cents=$((10#$b_int * 100 + 10#$b_dec))
	local result_cents=$((a_cents * b_cents / 100))
	printf -v DEC_RESULT '%d.%02d' $((result_cents / 100)) $((result_cents % 100))
}

# Soma dois valores decimais sem usar bc. Resultado em DEC_RESULT.
# Uso: dec_add "$total" "$subtotal"; total="$DEC_RESULT"
function dec_add() {
	local a="${1:-0}" b="${2:-0}"
	local a_int a_dec b_int b_dec
	a_int="${a%%.*}"
	if [[ "$a" == *.* ]]; then a_dec="${a#*.}"; else a_dec=0; fi
	b_int="${b%%.*}"
	if [[ "$b" == *.* ]]; then b_dec="${b#*.}"; else b_dec=0; fi
	a_dec="${a_dec}00"
	a_dec="${a_dec:0:2}"
	b_dec="${b_dec}00"
	b_dec="${b_dec:0:2}"
	local a_cents=$((10#$a_int * 100 + 10#$a_dec))
	local b_cents=$((10#$b_int * 100 + 10#$b_dec))
	local result_cents=$((a_cents + b_cents))
	printf -v DEC_RESULT '%d.%02d' $((result_cents / 100)) $((result_cents % 100))
}

# Subtrai dois valores decimais sem usar bc (aceita resultado negativo,
# usado para cálculo de troco). Resultado em DEC_RESULT.
# Uso: dec_sub "$efetivo" "$total_venda"; troco="$DEC_RESULT"
function dec_sub() {
	local a="${1:-0}" b="${2:-0}"
	local a_int a_dec b_int b_dec
	a_int="${a%%.*}"
	if [[ "$a" == *.* ]]; then a_dec="${a#*.}"; else a_dec=0; fi
	b_int="${b%%.*}"
	if [[ "$b" == *.* ]]; then b_dec="${b#*.}"; else b_dec=0; fi
	a_dec="${a_dec}00"
	a_dec="${a_dec:0:2}"
	b_dec="${b_dec}00"
	b_dec="${b_dec:0:2}"
	local a_cents=$((10#$a_int * 100 + 10#$a_dec))
	local b_cents=$((10#$b_int * 100 + 10#$b_dec))
	local result_cents=$((a_cents - b_cents))
	local sign=""
	if ((result_cents < 0)); then
		sign="-"
		result_cents=$((-result_cents))
	fi
	printf -v DEC_RESULT '%s%d.%02d' "$sign" $((result_cents / 100)) $((result_cents % 100))
}

# Formata um número (formato ponto, ex: vindo direto do banco) para
# exatamente 2 casas decimais, sem usar %f do printf. O printf %f
# interpreta a entrada de acordo com LC_NUMERIC e pode rejeitar algo
# como "11.3" como "número inválido" em locales com vírgula decimal
# (ex: pt_BR) - e prefixar com LC_NUMERIC=C não resolve de forma
# confiável, porque bash builtins usam o estado de locale já
# carregado do processo, não necessariamente a variável de ambiente
# de um prefixo temporário. Esta função usa só %d (inteiro), que
# nunca depende de locale. Resultado em FORMATAR_2_CASAS_RESULT.
# Uso: formatar_2_casas "$preco"; preco="$FORMATAR_2_CASAS_RESULT"
function formatar_2_casas() {
	local valor="$1"
	local parte_inteira parte_decimal sinal=""
	if [[ "$valor" == -* ]]; then
		sinal="-"
		valor="${valor#-}"
	fi
	if [[ "$valor" == *.* ]]; then
		parte_inteira="${valor%%.*}"
		parte_decimal="${valor#*.}"
	else
		parte_inteira="$valor"
		parte_decimal=""
	fi
	[[ -z "$parte_inteira" ]] && parte_inteira=0
	parte_decimal="${parte_decimal}00"
	parte_decimal="${parte_decimal:0:2}"
	printf -v FORMATAR_2_CASAS_RESULT '%s%d.%02d' "$sinal" "$((10#$parte_inteira))" "$((10#$parte_decimal))"
}

# Arredonda (não trunca) um valor decimal para 2 casas usando bc - para
# quando o valor vem de um SUM() do SQL, que pode ter cauda decimal por
# imprecisão de ponto flutuante (ex: "39.949999999999996") e precisa de
# arredondamento correto, não só corte como formatar_2_casas() faz.
# Corrige as inconsistências do bc: "0" sem decimais e valores menores
# que 1 sem o zero à esquerda (".50" em vez de "0.50"). Assume valor
# não-negativo (uso previsto: somas de vendas). Resultado em
# ARREDONDAR_MOEDA_RESULT.
function arredondar_moeda() {
	local valor="${1:-0}"
	local resultado
	resultado=$(echo "scale=2; ($valor + 0.005) / 1" | bc -l)
	local intpart="${resultado%%.*}"
	local decpart="${resultado#*.}"
	[[ "$resultado" != *.* ]] && decpart=""
	[[ -z "$intpart" ]] && intpart=0
	decpart="${decpart}00"
	decpart="${decpart:0:2}"
	ARREDONDAR_MOEDA_RESULT="${intpart}.${decpart}"
}

# Trunca e preenche uma string até exatamente N caracteres VISUAIS
# (não bytes), sem cortar no meio de um caractere acentuado (Ç, Ã,
# etc). Necessária porque sob locale POSIX/C (sem pt_BR instalada),
# ${#string}/${string:0:N}/printf "%-Ns" contam BYTES, não caracteres -
# um "Ç"/"Ã" ocupa 2 bytes mas só 1 posição visual na tela, causando
# desalinhamento entre o cabeçalho (com acento) e as linhas de dados
# (geralmente sem) nas telas de navegação em tabela. Resultado em
# UTF8_CAMPO_RESULT. Uso: utf8_campo "$valor" "$largura"
function utf8_campo() {
	local valor="$1"
	local largura="$2"
	local -i byte_len=${#valor}
	local -i i=0
	local -i chars=0
	local byte truncado=""
	while ((i < byte_len)); do
		byte="${valor:i:1}"
		if [[ "$byte" != [$'\x80'-$'\xbf'] ]]; then
			((chars >= largura)) && break
			((chars++))
		fi
		truncado+="$byte"
		((i++))
	done
	local stripped="${truncado//[$'\x80'-$'\xbf']/}"
	local -i visivel=${#stripped}
	local -i faltam=$((largura - visivel))
	if ((faltam > 0)); then
		local espacos
		printf -v espacos '%*s' "$faltam" ''
		UTF8_CAMPO_RESULT="${truncado}${espacos}"
	else
		UTF8_CAMPO_RESULT="$truncado"
	fi
}

