function sh_random_date() {
	local year=$((2000 + RANDOM % 23)) # 2000-2022
	local month=$((1 + RANDOM % 12))   # 1-12
	local max_day

	# Definir o número máximo de dias com base no mês gerado
	case $month in
	4 | 6 | 9 | 11)
		max_day=30
		;;
	2)
		if ((year % 4 == 0 && year % 100 != 0)) || ((year % 400 == 0)); then
			max_day=29
		else
			max_day=28
		fi
		;;
	*)
		max_day=31
		;;
	esac

	local day=$((1 + RANDOM % max_day))
	printf -v RANDOM_DATE_RESULT '%04d-%02d-%02d' "$year" "$month" "$day"
}

