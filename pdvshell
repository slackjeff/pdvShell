# Exibe uma tela de seleção (setas + Enter) com os fornecedores cadastrados
# e devolve (via echo) o id do fornecedor escolhido, ou nada se cancelado (ESC)
# ou se não houver fornecedores cadastrados.
function fornecedor_selecionar() {
	local xtitle="$(gettext "SELECIONAR FORNECEDOR")"
	local fornecedores_info
	local -a ids=()
	local -a itens=()
	local id nome
	local opcao
	local tecla_residual

	# Resultado devolvido via variável global (não por echo/$()): a função
	# desenha tela (tela/titulo/show_menu escrevem direto no terminal via
	# stdout), e capturar sua saída com $(...) engoliria TODA essa
	# renderização junto com o valor de retorno, deixando a tela em branco.
	FORNECEDOR_SELECIONADO_ID=""

	# Descarta qualquer tecla residual da tela anterior (ex: o Enter que
	# confirmou o campo em branco) antes de montar esta tela. Como nada
	# ainda foi desenhado, é seguro: o usuário não pode estar reagindo
	# a algo que ele ainda não viu.
	while read -rsn1 -t 0.01 tecla_residual; do :; done

	fornecedores_info=$(sqlite3 "$database" "SELECT id, nome FROM fornecedor ORDER BY nome;")

	if [[ -z "$fornecedores_info" ]]; then
		msgerror "$(gettext "Nenhum fornecedor cadastrado")"
		return 1
	fi

	while IFS='|' read -r id nome; do
		ids+=("$id")
		itens+=("$(printf "%-5s %s" "$id" "$nome")")
	done <<<"$fornecedores_info"

	tela
	titulo 1 "$xtitle" "${Acores[statussup]}"
	show_menu 11 10 "$xtitle" "${itens[@]}"
	opcao="$?"

	if ((opcao == 0)); then
		return 1 # ESC / cancelado
	fi

	FORNECEDOR_SELECIONADO_ID="${ids[$((opcao - 1))]}"
	return 0
}

