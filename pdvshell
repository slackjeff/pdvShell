function populate_database_produtos() {
	local i
	local nome un estoque qmin preco_cents preco codebar validade
	local fabricante=1
	local data
	local values

	msgok "$(gettext "Populando tabela produtos")"
	data="$(sh_date)" # mesma data para todos os registros, calculada uma única vez

	values=""
	for ((i = 1; i <= 100; i++)); do
		nome="Produto $i"
		un="UN"
		estoque=$((RANDOM % 1000))       # Estoque aleatório entre 0 e 999
		qmin=$((RANDOM % 100))           # Quantidade minima aleatório entre 0 e 99
		preco_cents=$((RANDOM % 10000))  # Preço aleatório entre 0.00 e 99.99
		printf -v preco '%d.%02d' $((preco_cents / 100)) $((preco_cents % 100))
		printf -v codebar '%013d' "$i" # Gere um código de barras simples
		sh_random_date
		validade="$RANDOM_DATE_RESULT"

		if [[ $((i % 5)) -eq 0 ]]; then # a cada 5 registros manter o fabricante
			fabricante="$((fabricante + 1))"
		fi

		[[ -n "$values" ]] && values+=","
		values+="('$nome', '$un', $estoque, $preco, '$codebar', '$data', '$validade', '$qmin', '$fabricante')"
	done

	sqlite3 "$database" "INSERT INTO produtos (nome, un, estoque, preco, codebar, data, validade, qmin, fabricante) VALUES $values;"
}

