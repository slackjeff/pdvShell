function _msg() {
	local row="$1"
	local msg="$2"
	local color="${3:-$green}"
	local color="$3"
	local timeout="${4:-1}"
	local IsBeep=0

	msg+="$(gettext " Pressione qualquer tecla para continuar")"
	local largura_terminal=$(tput cols)
	local largura_mensagem=${#msg}
	local coluna_inicio=$(((largura_terminal - largura_mensagem) / 2))
	[[ "$color" == "$red" ]] && IsBeep=1

	tput sc
	setpos "$row" 0
	printf "$reverse$color%-${largura_terminal}s" " "
	setpos "$row" "$coluna_inicio"
	((IsBeep)) && printf '\a'
	printf "$reverse$color%s" "$msg"
	((timeout < 0)) && sed -n q </dev/tty
	((timeout > 0)) && pause "$timeout"
	tput sgr0
	setpos "$row" 0
	tput el
	tput rc
}

box_msg() {
  local msg="$1"

  # pega tamanho real do terminal
  local rows cols
  rows=$(tput lines)
  cols=$(tput cols)

  local w=$(( ${#msg} + 4 ))
  local h=3
  local r=$(( (rows - h) / 2 ))
  local c=$(( (cols - w) / 2 ))

  # salva cursor
  tput sc

  # topo
  tput cup "$r" "$c"
  printf "+%s+\n" "$(printf '%*s' $((w-2)) '' | tr ' ' '-')"

  # meio
  tput cup "$((r+1))" "$c"
  printf "| %s |\n" "$msg"

  # fundo
  tput cup "$((r+2))" "$c"
  printf "+%s+\n" "$(printf '%*s' $((w-2)) '' | tr ' ' '-')"

  # restaura cursor
  tput rc
}

