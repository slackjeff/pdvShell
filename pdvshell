# Dimensões do terminal em cache: evita disparar 'tput lines'/'tput cols'
# (2 processos cada, por causa do $(...) + tput) toda vez que lastrow()/
# lastcol() são chamadas - e são chamadas MUITAS vezes pelo sistema todo.
# Atualizado uma vez no início e sempre que o terminal for redimensionado.
declare -gi _LASTROW_CACHE_=0
declare -gi _LASTCOL_CACHE_=0

function sh_atualizar_tamanho_tela() {
	_LASTROW_CACHE_=$(tput lines)
	_LASTCOL_CACHE_=$(tput cols)
}
trap 'sh_atualizar_tamanho_tela' WINCH

function lastrow() { echo "$_LASTROW_CACHE_"; }
