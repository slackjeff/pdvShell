function fornecedor_inclusao() {
	local xtitle="$(gettext "CADASTRO DE FORNECEDOR")"
	local data_dia="$(sh_date)"
	local fornecedor_info
	local fornecedor_id
	local fornecedor_nome
	local fornecedor_ende
  local fornecedor_data
  local fornecedor_cida
  local fornecedor_esta
  local fornecedor_cnpj
	local last_recno
	local IsHeader=0
	local half_lastcol=$(($(lastcol) / 2))
	local nome ende cida esta cnpj
	local query
	local tecla_residual

	while true; do
		fornecedor_info=
		fornecedor_id=
		fornecedor_data=
		fornecedor_nome=
		fornecedor_ende=
		fornecedor_cida=
		fornecedor_esta=
		fornecedor_cnpj=
		last_recno="$(lastrec 'fornecedor')"

		# Descarta qualquer tecla residual da tela anterior antes de redesenhar,
		# evitando que ela vaze para o primeiro campo (Nome) por conta do
		# atraso natural das chamadas de tela()/sqlite3 acima.
		while read -rsn1 -t 0.01 tecla_residual; do :; done

		tela
		titulo 1 "$xtitle" "${Acores[statussup]}"
		box 11 10 7 "$half_lastcol" "$xtitle" "${Acores[box]}"
		print 10 11 "$last_recno"
		print 12 11 "$(gettext "Nome")                 : "
		print 13 11 "$(gettext "Endereço")             : "
		print 14 11 "$(gettext "Cidade")               : "
		print 15 11 "$(gettext "Estado")               : "
		print 16 11 "$(gettext "CNPJ/CPF")             : "

		while true; do
			get 12 11 "$(gettext "Nome")                 : " nome "" "${Acores[box]}" "$((half_lastcol - 2))" || return
			if [[ -n "$nome" ]]; then
				if fornecedor_info=$(dbseek fornecedor nome "${nome^^}" "$IsHeader" 0) && [ -n "$fornecedor_info" ]; then
					alerta 18 10 "$(gettext "Fornecedor já cadastrado com esse nome")" "${Acores[msgerror]}"
					continue
				fi
				break
			else
				if yesno 18 10 "$(gettext "O nome não pode ser em branco. Cancelar?")"; then
					return
				fi
			fi
		done

		get 13 11 "$(gettext "Endereço")             : " ende "$fornecedor_ende" "${Acores[box]}" "$((half_lastcol - 2))" || return
		get 14 11 "$(gettext "Cidade")               : " cida "$fornecedor_cida" "${Acores[box]}" "$((half_lastcol - 2))" || return
		get 15 11 "$(gettext "Estado")               : " esta "$fornecedor_esta" "${Acores[box]}" "$((half_lastcol - 2))" || return

		while true; do
			get 16 11 "$(gettext "CNPJ/CPF")             : " cnpj "$fornecedor_cnpj" "${Acores[box]}" "$((half_lastcol - 2))" || return
			if [[ -z "$cnpj" ]]; then
				break
			elif validar_cnpj_cpf "$cnpj"; then
				break
			else
				alerta 18 10 "$(gettext "CNPJ/CPF inválido")" "${Acores[msgerror]}"
			fi
		done

		if yesno 18 10 "$(gettext "Confirma inclusão/atualização do fornecedor?")"; then
			nome=${nome^^}
			ende=${ende^^}
			cida=${cida^^}
			esta=${esta^^}
			[[ -n "$cnpj" ]] && cnpj="$(formatar_cnpj_cpf "$cnpj")"
			local nome_esc="$(sql_escape "$nome")"
			local ende_esc="$(sql_escape "$ende")"
			local cida_esc="$(sql_escape "$cida")"
			local esta_esc="$(sql_escape "$esta")"
			local cnpj_esc="$(sql_escape "$cnpj")"
			query="INSERT OR REPLACE INTO fornecedor (id,data, nome, ende, cida, uf, cnpj) VALUES (
		        (SELECT id FROM fornecedor WHERE id='$fornecedor_id'),
				'$data_dia', '$nome_esc', '$ende_esc', '$cida_esc', '$esta_esc', '$cnpj_esc'
			);"

			if sqlite3 "$database" "$query"; then
				alerta 18 10 "$Registro_efetuado_com_sucesso" "${Acores[msgok]}"
			else
				alerta 18 10 "$Erro_no_cadastro_atualizacao_do_registro" "${Acores[msgerror]}"
			fi
		else
			alerta 18 10 "$(gettext "Inclusão/alteração não efetuada.")" "${Acores[msgerror]}"
		fi
	done
}

