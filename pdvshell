function setpos() {
	local row="$1"
	local col="$2"

	Prow="$row"
	Pcol="$col"
	#	tput cup "$row" "$col"
	printf "\e[$((row + 1));$((col + 1))H"
}

function mabox() {
	# Parâmetros da função
	local ntop="$1"
	local nleft="$2"
	local nbottom="$3"
	local nright="$4"
	local color="$5"
	local espacos

	((ntop++))
	((nleft++))
	nbottom=$((ntop + nbottom - 1))

	if [[ -n "$color" ]]; then
		if ((color > 15)); then
			tput setab $color
		else
			tput setaf $color
		fi
	fi

	# Criação da moldura superior, inferior e do meio (sem subshell/fork)
	printf -v espacos '%*s' "$((nright - 2))" ''
	local frame_top="┌${espacos// /─}┐"
	local frame_bottom="└${espacos// /─}┘"
	local frame_middle="│${espacos}│"

	# Desenha a moldura superior
	printf "\e[%s;%sH%s" $ntop $nleft "$frame_top"

	# Desenha os lados do menu (linha do meio já pronta, sem refazer a cada volta)
	for ((i = 1; i <= nbottom - ntop; i++)); do
		printf "\e[$((ntop + i));%sH%s" $nleft "$frame_middle"
	done

	# Desenha a moldura inferior
	printf "\e[$((nbottom));%sH%s" $nleft "$frame_bottom"

	# Move o cursor para a última linha para evitar problemas de exibição
	#    printf "\e[$((nbottom - 1));1H"
}

function sh_fundo() {
	local color="${Acores[corpanofundo]}"
	local frame="${Acores[panofundo]}"
	local lastcol="$_LASTCOL_CACHE_"
	local lastrow="$_LASTROW_CACHE_"
	local buffer
	printf -v buffer '%*s' "$((lastcol * (lastrow - 3) / ${#frame}))" ''
	buffer="${buffer// /$frame}"
	printf "${color}\e[%s;%sH%s" 3 0 "$buffer"
}

function box() {
	local row="$1"
	local col="$2"
	local altura="$3"
	local largura="$4"
	local mensagem="$5"
	local color="$6"
	local color_boxtitle="${Acores[boxtitle]}"
	local tamanho=$((largura - 2))
	local largura_mensagem=${#mensagem}
	local coluna_inicio=$(((largura - largura_mensagem) / 2 + col))

	printf "%s" "$color"
	mabox "$row" "$col" "$altura" "$largura"

	if [[ -n "$mensagem" ]]; then
		setpos "$row" "$((col + 1))"
		printf "$reset$color_boxtitle%-${tamanho}s" " "
		setpos "$row" "$coluna_inicio"
		echo -e "$color_boxtitle$mensagem"
	fi
	printf '\e[0m'
}

read_manual() {
	local result=""
	local char

	while true; do
		# lê um caractere sem eco
		IFS= read -rsn1 char

		case "$char" in
		$'\e') # ESC
			echo "__ESC__"
			return 27
			;;
		$'\n') # ENTER
			echo "$result"
			return 0
			;;
		$'\177') # Backspace
			if [[ -n "$result" ]]; then
				result="${result:0:-1}"
				printf "\b \b"
			fi
			;;
		*)
			result+="$char"
			printf "%s" "$char"
			;;
		esac
	done
}

function get() {
	local row="$1"
	local col="$2"
	local prompt="$3"
	local new_value="$4" # nome da variável de saída
	local old_value="$5" # valor inicial
	local color="${6:-${Acores[box]}}"
	local largura="${7:-0}" # largura máxima a limpar antes de desenhar (0 = não limpa)
	local maxlen="${8:-0}"  # número máximo de caracteres aceitos (0 = sem limite)
	local input="" k
	local cursor=0
	local prev_len=0
	local base_col=$((col + ${#prompt}))

	# valor inicial visível/editável
	input="$old_value"
	cursor=${#input}

	setpos "$row" "$col"
	if ((largura > 0)); then
		printf "%s%s" "$reset" "$color"
		printf "%*s" "$largura" ""
		setpos "$row" "$col"
	fi
	printf "%s%s%s" "$reset" "$color" "$prompt"
	printf "%s%s" "$reverse" "$input"
	prev_len=${#input}
	setpos "$row" "$((base_col + cursor))"

	while true; do
		IFS= read -rsn1 k
		case "$k" in
		$'\e')
			local k2 k3 seq
			IFS= read -rsn1 -t 0.05 k2
			if [[ -z "$k2" ]]; then
				# ESC puro (sem mais bytes) = cancelar
				printf "%s" "$reset"
				return 1
			fi
			seq="$k2"
			if [[ "$k2" == "[" || "$k2" == "O" ]]; then
				while IFS= read -rsn1 -t 0.05 k3; do
					seq+="$k3"
					case "$k3" in
					[0-9] | ';') continue ;; # byte de parâmetro
					*) break ;;               # byte final, sequência completa
					esac
				done
			fi
			case "$seq" in
			"[D") ((cursor > 0)) && ((cursor--)) ;;                        # seta esquerda
			"[C") ((cursor < ${#input})) && ((cursor++)) ;;                # seta direita
			"[H" | "[1~" | "[7~" | "OH") cursor=0 ;;                       # home
			"[F" | "[4~" | "[8~" | "OF") cursor=${#input} ;;               # end
			"[3~")                                                        # delete
				((cursor < ${#input})) && input="${input:0:cursor}${input:cursor+1}"
				;;
			*) : ;; # seta cima/baixo, pgup/pgdn etc. - ignoradas
			esac
			;;
		"" | $'\n' | $'\r')
			printf "%s" "$reset"
			break
			;;
		$'\177' | $'\b')
			if ((cursor > 0)); then
				input="${input:0:cursor-1}${input:cursor}"
				((cursor--))
			fi
			;;
		*)
			if ((maxlen == 0 || ${#input} < maxlen)); then
				input="${input:0:cursor}${k}${input:cursor}"
				((cursor++))
			else
				printf '\a' # beep: limite de caracteres atingido
			fi
			;;
		esac

		# redesenha o campo inteiro (campos são curtos: datas, ids etc.)
		local pad=0
		((prev_len > ${#input})) && pad=$((prev_len - ${#input}))
		setpos "$row" "$base_col"
		printf "%s%s" "$reverse" "$input"
		if ((pad > 0)); then
			printf "%s" "$reset"
			printf "%*s" "$pad" ""
		fi
		prev_len=${#input}
		setpos "$row" "$((base_col + cursor))"
	done

	printf -v "$new_value" '%s' "$input"
	return 0
}

function readconf() {
	local msg="$1"
	local color="${2:-${Acores[conf]}}"
	local nobox="${3:-0}"
