function yesno() {
	local linha=$1
	local coluna=$2
	local titulo="$3"
	local itens=("$(gettext 'Sim')" "$(gettext 'Não')")
	local tamanho_maximo=${#titulo}
	local quantidade_itens="${#itens[@]}"
	local i tecla selecionado item_formatado
	local sair_do_menu=false
	local color="${Acores[conf]}"
	local item
	local t1 t2
	local altura
	local retorno

	tamanho_maximo=$((tamanho_maximo))
	for item in "${itens[@]}"; do
		((tamanho_maximo = tamanho_maximo < ${#item} ? ${#item} : tamanho_maximo))
	done
	altura=$((quantidade_itens + 4))

	box "$linha" "$coluna" "$altura" "$((tamanho_maximo + 2))" "" "$color"
	print "$((linha + 1))" "$((coluna + 1))" "$titulo" "$color"
	print "$((linha + 2))" "$((coluna))" "├$(replicate "─" "$((tamanho_maximo))")┤" "$color"
	printf '\a' # beep

	while ! $sair_do_menu; do
		for i in "${!itens[@]}"; do
			local item="${itens[i]}"
			local padding=$((tamanho_maximo - ${#item} - 2))
			[[ -n "${aCorItemMenu[i]}" ]] && color="${aCorItemMenu[i]}"
			if [[ $i -eq $selecionado ]]; then
				item_formatado="${reverse}${color}►${item^^}◄%${padding}s${reset}"
			else
				item_formatado="${color} ${item^} %${padding}s${reset}"
			fi
			printf "\e[$((linha + i + 4));%sH${item_formatado}${rst}" "$((coluna + 2))"
		done

		read -rsn1 tecla
		case "$tecla" in
		$'\e')
			# ESC puro ou início de sequência ANSI
			if read -rsn1 -t 0.01 t1 && [[ $t1 == "[" ]]; then
				read -rsn1 t2
				case "$t2" in
				A) ((selecionado = selecionado > 0 ? selecionado - 1 : quantidade_itens - 1)) ;; # ↑
				B) ((selecionado = selecionado < quantidade_itens - 1 ? selecionado + 1 : 0)) ;; # ↓
				C) ((selecionado = selecionado < quantidade_itens - 1 ? selecionado + 1 : 0)) ;; # →
				D) ((selecionado = selecionado > 0 ? selecionado - 1 : quantidade_itens - 1)) ;; # ←
				esac
			else
				retorno=1 # ESC puro
				sair_do_menu=true
			fi
			;;
		"" | $'\n' | $'\r')
			retorno=$((selecionado)) # ENTER → SEMPRE com argumento
			sair_do_menu=true
			;;
		esac
	done

	# Fecha o diálogo repintando as linhas da caixa com o mesmo padrão de
	# fundo do sistema (igual sh_fundo faz para a tela inteira), em vez de
	# apagar para o preto padrão do terminal. Não mexe no resto da tela.
	local cols="$(lastcol)"
	local frame="${Acores[panofundo]}"
	local buffer="$(replicate "$frame" "$((cols * altura / ${#frame} + 1))")"
	tput sgr0
	setpos "$linha" 0
	printf "%s%s" "${Acores[corpanofundo]}" "$buffer"
	tput sgr0
	setpos "$linha" "$coluna"

	return "$retorno"
}

# Caixa de alerta estilo msgbox (dialog --msgbox): moldura, mensagem e um
# único botão [ OK ] centralizados. Diferente do yesno(), não é uma seleção
# Sim/Não - é só um aviso que precisa ser lido e confirmado com Enter, sem
# risco de "vazar" tecla para o campo seguinte (ao contrário de msgerror/
# msgok, que usam uma barra no topo da tela com timeout curto).
function alerta() {
	local linha=$1
	local coluna=$2
	local msg="$3"
	local color="${4:-${Acores[conf]}}"
	local botao="[ $(gettext 'OK') ]"
	local tamanho_maximo=${#msg}
	local tecla
	local padding_msg
	local padding_botao

	((tamanho_maximo = tamanho_maximo < ${#botao} ? ${#botao} : tamanho_maximo))

	box "$linha" "$coluna" 6 "$((tamanho_maximo + 2))" "" "$color"

	padding_msg=$(((tamanho_maximo - ${#msg}) / 2))
	print "$((linha + 1))" "$((coluna + 1 + padding_msg))" "$msg" "$color"

	print "$((linha + 2))" "$coluna" "├$(replicate "─" "$tamanho_maximo")┤" "$color"
	printf '\a' # beep

	padding_botao=$(((tamanho_maximo - ${#botao}) / 2))
	print "$((linha + 4))" "$((coluna + 1 + padding_botao))" "${reverse}${botao}${reset}" "$color"

	while true; do
		read -rsn1 tecla
		case "$tecla" in
		"" | $'\n' | $'\r')
			break
			;;
		esac
	done

	# Fecha o diálogo repintando as linhas da caixa com o mesmo padrão de
	# fundo do sistema (igual sh_fundo faz para a tela inteira), em vez de
	# apagar para o preto padrão do terminal. Não mexe no resto da tela.
	local cols="$(lastcol)"
	local frame="${Acores[panofundo]}"
	local buffer="$(replicate "$frame" "$((cols * 6 / ${#frame} + 1))")"
	tput sgr0
	setpos "$linha" 0
	printf "%s%s" "${Acores[corpanofundo]}" "$buffer"
	tput sgr0
	setpos "$linha" "$coluna"
}

function titulo() {
	local row="$1"
	local mensagem="$2"
	local color="${3:-$black}"
	local extra_left="$4"
	local extra_right="$5"
	local largura_terminal=$_LASTCOL_CACHE_
	local largura_mensagem=${#mensagem}
	local coluna_inicio=$(((largura_terminal - largura_mensagem) / 2))
	local nlen

	printf '\e[s' # Salva a posição atual do cursor
	setpos "$row" 0
	printf "$color%-${largura_terminal}s" ''

	if [[ -n "$extra_left" ]]; then
		setpos "$row" 0
		printf "$bold$white%s" "$extra_left"
	fi

	if [[ -n "$extra_right" ]]; then
		nlen=${#extra_right}
		setpos "$row" $((largura_terminal - nlen))
		printf "$bold$white%s" "$extra_right"
	fi

	setpos "$row" "$coluna_inicio"
	printf "$bold$white%s" "$mensagem"
	printf '\e[0m'
	printf '\e[u'
}

